# Copy to .env.local for local runs (`python agent.py dev`).
# On LiveKit Cloud these are set as agent secrets instead; nothing here is
# committed with a real value.

# LiveKit project — `lk app env` will print these for the authenticated project.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Gemini Live. Same key as the GEMINI_API_KEY Supabase secret.
GOOGLE_API_KEY=

# Read-only catalog access. The anon key is correct here: products are
# world-readable, and the agent must never hold a user's token — anything
# user-scoped happens on the phone, over RPC.
SUPABASE_URL=https://asnjjkpjuqsmjqrjojzl.supabase.co
SUPABASE_ANON_KEY=
