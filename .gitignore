**/.dart_tool/
**/.packages
**/.pub-cache/
**/build/
**/android/.gradle/
**/android/app/build/
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/ephemeral/
**/.flutter-plugins
**/.flutter-plugins-dependencies

