<?xml version="1.0" encoding="utf-8"?>
<!-- The window Android paints before the Flutter engine draws its first frame.
     It was plain white, so a cold start flashed white and then jumped into the
     app's mint splash. This matches the splash's top gradient stop, so the
     transition is invisible. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/brand_splash_background" />
</layer-list>
