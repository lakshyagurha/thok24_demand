<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Generated by flutter_launcher_icons for the adaptive icon's background
         layer. Must stay in step with `adaptive_icon_background` in pubspec.yaml. -->
    <color name="ic_launcher_background">#2E6F40</color>

    <!-- Top stop of AppGradients.heroSoft, so the native launch window Android
         paints before the Flutter engine starts is the same colour as the
         splash that follows it, and the handover is invisible. -->
    <color name="brand_splash_background">#C7E9D5</color>
</resources>
