# DxMart PHP backend — environment configuration
#
# Copy to `.env` (gitignored) or export these in the web server's environment.
# NOTHING in this file should ever contain a real secret — it documents names only.

# --- Database (local XAMPP dev defaults shown) ---
# The local development database is `thok24`. The old "dxmart" name does not exist.
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=thok24

# --- Gemini (BolKeOrder voice intent extraction) ---
# If unset, process_chat.php degrades to deterministic regex-only extraction
# instead of failing. Rotate at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- SMTP (order confirmation emails) ---
# If unset, send_email_background.php logs and skips sending instead of crashing.
# Rotate the Gmail App Password at https://myaccount.google.com/apppasswords
SMTP_USERNAME=
SMTP_PASSWORD=
